# Streamlit Secrets Template
   # ============================
   # DO NOT put your real API key in this file if it's committed to git.
   # This file shows the expected format only.
   #
   # On Streamlit Community Cloud:
   #   1. Go to your app's "Settings" → "Secrets"
   #   2. Paste contents in this format, replacing the placeholder
   #   3. Save — the app picks it up automatically

   ANTHROPIC_API_KEY = "sk-ant-your-actual-key-here"
